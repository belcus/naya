# Base de données (dev local = SQLite, prod cible = PostgreSQL/Supabase)
DATABASE_URL="file:./dev.db"

# Session
SESSION_COOKIE_NAME="naya_session"

# Fournisseurs (abstraits — voir src/lib/providers)
# "dev" simule SMS/appel/paiement localement pour le développement.
# A remplacer en production par des fournisseurs réels une fois confirmés pour le Niger.
OTP_PROVIDER="dev"
CALL_PROVIDER="dev"
PAYMENT_PROVIDER="dev"

